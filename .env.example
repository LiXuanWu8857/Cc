# =============================================================================
# FoodTrack environment — EXAMPLE ONLY. Copy to .env.local and fill in.
# NEVER commit real secrets. See 01_SECURITY_ARCHITECTURE.md, principle #07.
# =============================================================================

# ---- Public (safe to expose to the browser) --------------------------------
# These two are the ONLY Supabase values allowed in the client bundle.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---- Server-only secrets (MUST NOT reach the browser) ----------------------
# service_role bypasses RLS. Used ONLY by controlled system jobs (OCR ingest,
# reviewed food import, migrations). See §4.7. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct DB connection (migrations / server jobs only).
DATABASE_URL="postgresql://postgres:password@localhost:54322/postgres"

# OCR / AI providers — server-only. Not selected yet in V1; placeholders.
# OCR_PROVIDER_API_KEY=""
# AI_PROVIDER_API_KEY=""
